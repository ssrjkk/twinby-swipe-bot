# Twinby API: один аккаунт, экспериментальный контракт
TWINBY_BASE_URL=https://api.twinby.com/v1
TWINBY_ACCESS_TOKEN=
TWINBY_REFRESH_TOKEN=
PROXY_URL=

# ── Лимиты и фильтры ──────────────────────────────────────────────────────────
DAILY_LIKE_LIMIT=150
MIN_SWIPE_DELAY=2.5
MAX_SWIPE_DELAY=7.5
MIN_COMPATIBILITY=75
MAX_DISTANCE_KM=25
MIN_AGE=18
MAX_AGE=30
REQUIRE_BIO=false

# ── Универсальный LLM-шлюз ────────────────────────────────────────────────────
# openai | anthropic | gemini | openrouter | deepseek | ollama | custom
AI_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Нестандартный заголовок ключа, например x-api-key; пусто = формат по провайдеру
CUSTOM_AUTH_HEADER=

# Telegram-пульт и web API (не браузерная панель)
# TG_BOT_TOKEN и TWINBY_ACCESS_TOKEN обязательны и не могут быть пустыми.
# TG_ADMIN_ID — положительный числовой ID администратора.
TG_BOT_TOKEN=
TG_ADMIN_ID=
# Независимый секрет: пусто = REST API и WebSocket отключены.
# Не используйте TG_BOT_TOKEN. REST и небраузерный WebSocket /ws/live принимают
# только заголовок Authorization: Bearer <WEB_ADMIN_TOKEN>, не query-параметры.
WEB_ADMIN_TOKEN=
WEB_HOST=127.0.0.1
# WebSocket без Origin разрешён; если Origin указан, он должен быть в этом списке.
WEB_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=sqlite+aiosqlite:///./data/twinby_bot.db

# ── Google Calendar (бронь встречи, опционально) ──────────────────────────────
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Device-слой: свайпы Twinby на телефоне (device/run_*.py) ──────────────────
# claude | openai | gemini | custom
AGENT=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LIKE_THRESHOLD=75
MAX_SWIPES=50
DELAY_MIN=3
DELAY_MAX=7
APPIUM_HOST=http://127.0.0.1:4723
IOS_UDID=auto
IOS_PLATFORM_VERSION=17.0
SIM_UDID=
SIM_PLATFORM_VERSION=17.0