# --- Режим работы (<3 v3.9.0) ---
MODE=ui_vision
PLATFORM=twinby
DRY_RUN=true
AUTO_SEND_REPLIES=false
USER_PREFERENCES=интеллект, чувство юмора, путешествия, кофе, искренность, без рекламы

# --- Мобильный драйвер (MODE=ui_vision) ---
DEVICE_DRIVER=adb
DEVICE_OS=Android
DEVICE_UDID=
APPIUM_URL=http://localhost:4723
APP_PACKAGE=
CAPTURE_SECOND_VIEW=false

# --- Браузерный драйвер (MODE=web_vision) ---
WEB_TARGET_URL=
WEB_PROFILE_DIR=./data/browser_profile
WEB_HEADLESS=false

# --- Антибан-ритм ---
DAILY_LIKE_LIMIT=150
MAX_SWIPES_PER_HOUR=45
SESSION_BURST_SIZE=25
SESSION_BREAK_MINUTES_MIN=8
SESSION_BREAK_MINUTES_MAX=20
ENFORCE_ACTIVE_HOURS=false
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=23
MIN_SWIPE_DELAY=2.5
MAX_SWIPE_DELAY=7.5

# --- Универсальный ИИ-шлюз (OpenAI, Anthropic, Gemini, OpenRouter, DeepSeek, Ollama, Custom) ---
LLM_ENABLED=true
AI_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
CUSTOM_AUTH_HEADER=

# --- Фильтры и локальная проверка лиц (опционально) ---
MIN_COMPATIBILITY=70
MAX_DISTANCE_KM=25
MIN_AGE=18
MAX_AGE=30
REQUIRE_BIO=false
MIN_SCORE_THRESHOLD=60.0
FACE_CHECK_ENABLED=false
FACE_SIMILARITY_THRESHOLD=0.42

# --- Веб-панель, БД, бэкапы, Redis и Telegram ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_API_TOKEN=
METRICS_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/heart3.db
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
REDIS_URL=
TG_BOT_TOKEN=
TG_ADMIN_ID=0

# --- API-режим (MODE=api) и Google Calendar (опционально) ---
TWINBY_BASE_URL=https://api.twinby.com/v1
TWINBY_ACCESS_TOKEN=
TWINBY_REFRESH_TOKEN=
API_PLATFORM_TOKEN=
PROXY_URL=
PROXIES_FILE=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
